# Desktop PQC / 混合证：自动加载四个 provider（由 apps/openssl 在未设置 OPENSSL_CONF 时使用）
#   pqmagic-algorithms-provider  — ML-DSA-44-SPKI / ML-KEM-512-SPKI / ML-DSA-44-with-SM3 (certs/1)
#   x509-hybrid-spki-provider    — ML-DSA-44-SM2 / ML-KEM-512-SM2 复合 SPKI (certs/2)
#   x509-hybrid-verify-provider  — 混合证 / 复合证验签 (certs/1/2/3)
#   ntls-aigis-provider          — Aigis-Enc-2 KEM (NTLS，可选；模块不存在时忽略)

config_diagnostics = 0

openssl_conf = openssl_init

[openssl_init]
providers = provider_sect

[provider_sect]
default = default_sect
pqmagic = pqmagic_sect
ml_dsa_sm2 = ml_dsa_sm2_sect
cert_verify = cert_verify_sect
aigis_enc = aigis_enc_sect

[default_sect]
activate = 1

[pqmagic_sect]
module = /home/wang/Desktop/pqmagic-algorithms-provider/build/pqmagic.so
activate = 1

[ml_dsa_sm2_sect]
module = /home/wang/Desktop/x509-hybrid-spki-provider/libml_dsa_sm2_provider.so
activate = 1

[cert_verify_sect]
module = /home/wang/Desktop/x509-hybrid-verify-provider/cert_verify.so
activate = 1

[aigis_enc_sect]
module = /home/wang/Desktop/ntls-aigis-provider/build/aigis_enc.so
activate = 1
